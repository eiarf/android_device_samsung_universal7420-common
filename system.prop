# Boot device
ro.boot.bootdevice=15570000.ufs

# Dalvik
dalvik.vm.dex2oat64.enabled=true

# HWC
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
debug.renderengine.backend=skiaglthreaded
debug.sf.predict_hwc_composition_strategy=0
# SurfaceFlinger main on the A57s. Under ADPF its uclamp.min sits at 2-38,
# which fits an A53, so it composited on cpu5 at 400-600 MHz and apps
# waited 4-5 ms for a free buffer. A fixed uclamp.min of 600 keeps it on
# the big cores (with kernel e147acb6); about +50 mA.
debug.sf.enable_adpf_cpu_hint=false
ro.surface_flinger.uclamp.min=600
debug.hwui.use_hint_manager=true

# Media. No IOmx service is declared, so the default Codec2 input surface
# comes back null and CCodec::createInputSurface() crashes (screenrecord,
# PCMark Video Editing, any surface-fed encoder). -1 avoids that path.
debug.stagefright.c2inputsurface=-1

# NFC
ro.nfc.fw_dl_on_boot=false

# Recovery
persist.vendor.recovery_update=false

# Board. ro.arch is platform-owned (build_prop), so init refuses it
# from vendor properties.
ro.arch=exynos7420
