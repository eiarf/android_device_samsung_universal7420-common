+++ b/release/aconfig/bp1a/Android.bp
@@ -17,6 +17,8 @@ aconfig_value_set {
     name: "aconfig_value_set-lineage-bp1a",
     values: [
         "aconfig-values-bp1a-android.hardware.biometrics-all",
+        "aconfig-values-bp1a-android.view.flags-all",
+        "aconfig-values-bp1a-com.android.server.flags-all",
         "aconfig-values-bp1a-com.android.window.flags-all",
     ],
 }
diff --git a/release/aconfig/bp1a/android.view.flags/Android.bp b/release/aconfig/bp1a/android.view.flags/Android.bp
new file mode 100644
index 0000000..e00c699
--- /dev/null
+++ b/release/aconfig/bp1a/android.view.flags/Android.bp
@@ -0,0 +1,7 @@
+aconfig_values {
+    name: "aconfig-values-bp1a-android.view.flags-all",
+    package: "android.view.flags",
+    srcs: [
+        "*_flag_values.textproto",
+    ],
+}
diff --git a/release/aconfig/bp1a/android.view.flags/buffer_stuffing_recovery_flag_values.textproto b/release/aconfig/bp1a/android.view.flags/buffer_stuffing_recovery_flag_values.textproto
new file mode 100644
index 0000000..dbd1642
--- /dev/null
+++ b/release/aconfig/bp1a/android.view.flags/buffer_stuffing_recovery_flag_values.textproto
@@ -0,0 +1,6 @@
+flag_value {
+  package: "android.view.flags"
+  name: "buffer_stuffing_recovery"
